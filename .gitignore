# =============================================================================
# SpinDeck — root .gitignore
# Monorepo: pnpm + Turborepo + Tauri (Rust) + VitePress
# =============================================================================

# ----- Dependencies -----
node_modules/
.pnp
.pnp.js
.pnpm-store/
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Accidental alternate lockfiles (pnpm is mandatory)
package-lock.json
yarn.lock
npm-shrinkwrap.json

# ----- Environment -----
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# ----- Logs & debug -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.dbg/
*.ndjson

# ----- Tests & coverage -----
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ----- Caches -----
.turbo/
.cache/
**/.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
tsconfig.tsbuildinfo
.vite/
vite.config.*.timestamp-*

# ----- Build outputs -----
.next/
out/
build/
dist/
.react-router/
storybook-static/
tmp/
temp/
*.tmp
*.temp

# VitePress (docs/)
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/.vitepress/.temp/

# ----- Rust / Cargo -----
# Canonical Tauri crate (also listed under apps/desktop/.gitignore)
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
**/target/
**/*.rs.bk
*.pdb

# ----- Tauri desktop -----
# Bundled SPA + prepared resources (prepare-resources / prepare-dev-resources)
apps/desktop/src-tauri/resources/
apps/desktop/.cache/
# Generated icon intermediate (pnpm desktop:icons)
apps/desktop/assets/app-icon.png
# Do not invent a root-level src-tauri
/src-tauri/

# Accidental installer dumps at repo root
/*.dmg
/*.AppImage
/*.msi
/*.deb
/*.rpm
/*.exe
/*.app/

# ----- Vercel / deploy -----
.vercel/
.netlify/

# ----- IDEs & editors -----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.history/
.ionide/

# ----- OS junk -----
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ----- Misc / tooling -----
.husky/_/
.direnv/
.venv/
venv/
__pycache__/
*.py[cod]
